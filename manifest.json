{
   "manifest_version": 3,
   "name": "GrabPost - Downloader for Reddit",
   "description": "Download images, videos and galleries from Reddit posts, including Redgifs.",
   "version": "1.50.3",
   "key": "",
   "icons": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
   },
   "background": {
      "service_worker": "src/background.js",
      "type": "module"
   },
   "content_scripts": [
      {
         "matches": [
            "*://*.reddit.com/*"
         ],
         "js": [
            "src/content.js"
         ],
         "css": [
            "css/content.css"
         ]
      }
   ],
   "action": {
      "default_title": "GrabPost"
   },
   "side_panel": {
      "default_path": "sidepanel.html"
   },
   "permissions": [
      "downloads",
      "activeTab",
      "storage",
      "tabs",
      "sidePanel",
      "alarms",
      "notifications",
      "declarativeNetRequest",
      "cookies",
      "offscreen",
      "unlimitedStorage",
      "contextMenus",
      "scripting"
   ],
   "host_permissions": [
      "*://*.reddit.com/*",
      "*://*.redd.it/*",
      "*://*.redditmedia.com/*",
      "*://*.redgifs.com/*",
      "*://api.redgifs.com/*"
   ],
   "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
   },
   "web_accessible_resources": [
      {
         "resources": [
            "locales.js",
            "src/media.js"
         ],
         "matches": [
            "*://*.reddit.com/*"
         ]
      }
   ],
   "commands": {
      "download-focused-post": {
         "suggested_key": {
            "default": "Alt+Shift+D"
         },
         "description": "Download the post in the middle of the screen"
      }
   },
   "optional_permissions": [
      "clipboardRead"
   ]
}